      "questions": [
        "Hvem var fri?"
      ],
      "easier": "Forsvareren får bare gå.",
      "harder": "En ny forsvarer løper inn fra siden når den første pasningen er slått.",
      "figure": null,
      "source": "G10-planen",
      "version": 1
    },
